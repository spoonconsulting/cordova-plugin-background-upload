{
  "name": "demo",
  "version": "0.0.2",
  "author": "Ionic Framework",
  "homepage": "https://ionicframework.com/",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "check-updates": "npx npm-check-updates",
    "postinstall": "npx patch-package",
    "cleanUp": "rm -rf {platforms,plugins} & npm i",
    "run:android": "ionic cordova run android",
    "run:android:livereload": "ionic cordova run android --verbose --livereload --host=192.168.1.3",
    "run:ios": "ionic cordova run ios",
    "run:ios:livereload": "ionic cordova emulate ios --livereload"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "~18.2.9",
    "@angular/core": "~18.2.9",
    "@angular/forms": "~18.2.9",
    "@angular/platform-browser": "~18.2.9",
    "@angular/platform-browser-dynamic": "~18.2.9",
    "@angular/router": "~18.2.9",
    "@awesome-cordova-plugins/background-upload": "^6.9.0",
    "@awesome-cordova-plugins/core": "^6.9.0",
    "@awesome-cordova-plugins/file": "^6.9.0",
    "@awesome-cordova-plugins/image-picker": "^6.9.0",
    "@awesome-cordova-plugins/ionic-webview": "^6.9.0",
    "@ionic/angular": "^8.3.3",
    "cordova-ios": "7.1.1",
    "rxjs": "~7.8.1",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~18.2.10",
    "@angular-eslint/builder": "~18.4.0",
    "@angular-eslint/eslint-plugin": "~18.4.0",
    "@angular-eslint/eslint-plugin-template": "~18.4.0",
    "@angular-eslint/template-parser": "~18.4.0",
    "@angular/cli": "~18.2.10",
    "@angular/compiler": "~18.2.9",
    "@angular/compiler-cli": "~18.2.9",
    "@angular/language-service": "~18.2.9",
    "@ionic/angular-toolkit": "^12.1.1",
    "@ionic/cordova-builders": "^12.1.2",
    "@spoonconsulting/cordova-plugin-background-upload": "4.1.1",
    "@spoonconsulting/cordova-plugin-telerik-imagepicker": "^2.1.2",
    "@typescript-eslint/eslint-plugin": "8.11.0",
    "@typescript-eslint/parser": "8.11.0",
    "cordova-android": "^13.0.0",
    "cordova-plugin-device": "3.0.0",
    "cordova-plugin-file": "8.1.0",
    "cordova-plugin-ionic-keyboard": "^2.2.0",
    "cordova-plugin-ionic-webview": "^5.0.1",
    "cordova-plugin-statusbar": "4.0.0",
    "cordova-res": "^0.15.4",
    "eslint": "^9.13.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsdoc": "50.4.3",
    "eslint-plugin-prefer-arrow": "1.2.3",
    "native-run": "^2.0.1"
  },
  "description": "An Ionic project",
  "cordova": {
    "plugins": {
      "cordova-plugin-statusbar": {},
      "cordova-plugin-device": {},
      "cordova-plugin-ionic-webview": {
        "ANDROID_SUPPORT_ANNOTATIONS_VERSION": "27.+"
      },
      "cordova-plugin-ionic-keyboard": {},
      "cordova-plugin-file": {
        "ANDROIDX_WEBKIT_VERSION": "1.6.0"
      },
      "@spoonconsulting/cordova-plugin-telerik-imagepicker": {
        "PHOTO_LIBRARY_USAGE_DESCRIPTION": " "
      },
      "@spoonconsulting/cordova-plugin-background-upload": {}
    },
    "platforms": [
      "android",
      "ios"
    ]
  }
